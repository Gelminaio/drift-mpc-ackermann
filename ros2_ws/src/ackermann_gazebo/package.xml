<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ackermann_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo simulation of the car in the test room</description>
  <maintainer email="gelmini.pietro@gmail.com">pietro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ackermann_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_sim_vendor</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ackermann_description</exec_depend>
  <exec_depend>ackermann_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
